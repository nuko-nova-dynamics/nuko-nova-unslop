{
  "name": "nuko-nova-unslop-workspace",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "check": "python3 tests/validate_bundle.py && python3 -m unittest discover -s tests -p 'test_*.py' && pnpm mcp:check",
    "mcp:generate": "pnpm --filter @nuko-nova/unslop-mcp generate",
    "mcp:test": "pnpm --filter @nuko-nova/unslop-mcp test",
    "mcp:typecheck": "pnpm --filter @nuko-nova/unslop-mcp typecheck",
    "mcp:check": "pnpm --filter @nuko-nova/unslop-mcp check",
    "mcp:dev": "pnpm --filter @nuko-nova/unslop-mcp dev",
    "mcp:deploy": "pnpm --filter @nuko-nova/unslop-mcp run deploy"
  }
}
